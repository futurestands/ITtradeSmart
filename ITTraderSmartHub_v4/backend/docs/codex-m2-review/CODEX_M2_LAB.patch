--- /dev/null
+++ b/src/nas100lab/timebase_observation.py
@@ -0,0 +1,38 @@
+"""Offline UTC witness assessment. Never transforms labels or certifies history.
+
+An eventual collector must bracket one read-only tick metadata call with aware
+UTC and monotonic clocks, recording clock synchronization evidence separately.
+A single matching sample cannot establish historical DST rules or eligibility.
+"""
+from datetime import datetime, timedelta
+from math import isfinite
+
+
+def assess_tick_clock(*, raw_epoch: int, utc_before: datetime, utc_after: datetime,
+                      monotonic_elapsed_seconds: float) -> dict:
+    for clock in (utc_before, utc_after):
+        if not isinstance(clock, datetime) or clock.utcoffset() != timedelta(0):
+            raise ValueError('Observation clocks must be aware UTC')
+    if type(raw_epoch) is not int or raw_epoch <= 0:
+        raise ValueError('Raw tick epoch must be a positive integer')
+    wall_elapsed = (utc_after-utc_before).total_seconds()
+    if (type(monotonic_elapsed_seconds) not in (int, float)
+            or not isfinite(monotonic_elapsed_seconds)
+            or not 0 <= wall_elapsed <= 5
+            or monotonic_elapsed_seconds < 0
+            or abs(wall_elapsed-monotonic_elapsed_seconds) > 0.25):
+        raise ValueError('Unstable, reversed or excessive observation clock interval')
+    # Epoch seconds are truncated; permit at most one second of quantization.
+    lower = raw_epoch-utc_after.timestamp()
+    upper = raw_epoch-utc_before.timestamp()
+    if lower > 1:
+        status = 'SOURCE_LABEL_AHEAD_OF_UTC_BRACKET'
+    elif upper < -1:
+        status = 'STALE_OR_DIFFERENT_CLOCK_UNRESOLVED'
+    else:
+        status = 'WITHIN_UTC_BRACKET_NOT_CERTIFIED'
+    return {'observation': status, 'raw_epoch': raw_epoch,
+            'raw_epoch_preserved': True, 'offset_interval_seconds': [lower, upper],
+            'timebase_status': 'TIMEBASE_UNVERIFIED', 'research_eligible': False,
+            'limitations': ['Host UTC synchronization and quote freshness need independent evidence.',
+                            'No historical offset or DST policy is certified by this observation.']}
diff --git a/tests/test_codex_m2_reproducibility_review.py b/tests/test_codex_m2_reproducibility_review.py
