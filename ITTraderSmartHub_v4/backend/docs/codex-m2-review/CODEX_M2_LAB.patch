--- /dev/null
+++ b/tests/test_codex_m2_reproducibility_review.py
@@ -0,0 +1,96 @@
+"""Independent M1 adversarial review. Synthetic bytes/configs only; no fitting."""
+import json
+
+import pytest
+
+from nas100lab import reproducibility as rep
+from test_m1_reproducibility import completed_card, variant
+
+
+def test_nested_config_keys_must_not_collide_with_string_keys():
+    textual = rep.config_hash({'model': {'1': 'a'}})
+    with pytest.raises(rep.ReproducibilityError):
+        rep.config_hash({'model': {1: 'a'}})
+    assert len(textual) == 64
+
+
+def test_cyclic_config_has_a_controlled_validation_error():
+    config = {}
+    config['self'] = config
+    with pytest.raises(rep.ReproducibilityError):
+        rep.config_hash(config)
+
+
+def test_nested_manifest_scan_uses_manifest_root_coordinates(tmp_path):
+    nested = tmp_path/'data'
+    nested.mkdir()
+    (nested/'bars.csv').write_text('SYNTHETIC_BYTES\n', encoding='utf-8')
+    manifest = rep.create_dataset_manifest(['data/bars.csv'], root=tmp_path, dataset_id='SYNTHETIC')
+    report = rep.verify_dataset_manifest(manifest, root=tmp_path, strict_directory=nested)
+    assert report['files_verified'] == 1 and not report['research_eligible']
+
+
+def test_strict_scan_rejects_unrelated_directory_even_if_empty(tmp_path):
+    root, other = tmp_path/'root', tmp_path/'other'
+    root.mkdir()
+    other.mkdir()
+    (root/'bars.csv').write_bytes(b'SYNTHETIC')
+    manifest = rep.create_dataset_manifest(['bars.csv'], root=root, dataset_id='SYNTHETIC')
+    with pytest.raises(rep.ReproducibilityError):
+        rep.verify_dataset_manifest(manifest, root=root, strict_directory=other)
+
+
+@pytest.mark.parametrize('field', ['research_eligible', 'training_enabled'])
+def test_integrity_flags_require_boolean_false_not_numeric_zero(tmp_path, field):
+    (tmp_path/'bars.csv').write_bytes(b'SYNTHETIC')
+    manifest = rep.create_dataset_manifest(['bars.csv'], root=tmp_path, dataset_id='SYNTHETIC')
+    manifest[field] = 0
+    body = {k: v for k, v in manifest.items() if k != 'manifest_digest'}
+    manifest['manifest_digest'] = rep.sha256_hex(rep.canonical_bytes(body))
+    with pytest.raises(rep.ReproducibilityError):
+        rep.verify_dataset_manifest(manifest, root=tmp_path)
+
+
+@pytest.mark.parametrize('field,value', [
+    ('schema', 'unsupported'), ('model_id', None), ('model_version', ''), ('intended_use', []),
+])
+def test_model_card_rejects_invalid_identity_or_schema(field, value):
+    card = completed_card()
+    card[field] = value
+    with pytest.raises(rep.ReproducibilityError):
+        rep.validate_model_card(card)
+
+
+def test_model_card_requires_schema():
+    card = completed_card()
+    del card['schema']
+    with pytest.raises(rep.ReproducibilityError):
+        rep.validate_model_card(card)
+
+
+def test_model_card_rejects_contradictory_evaluation_status():
+    card = completed_card()
+    card['evaluation']['status'] = 'REAL_MARKET_PROFITABILITY_VALIDATED'
+    with pytest.raises(rep.ReproducibilityError):
+        rep.validate_model_card(card)
+
+
+def test_variant_append_refuses_corrupt_history_without_writing(tmp_path):
+    log = tmp_path/'variants.jsonl'
+    rep.append_variant(log, variant('first'))
+    entry = json.loads(log.read_text())
+    entry['config']['seed'] = 999
+    log.write_text(json.dumps(entry)+'\n', encoding='utf-8')
+    before = log.read_bytes()
+    with pytest.raises(rep.ReproducibilityError):
+        rep.append_variant(log, variant('second'))
+    assert log.read_bytes() == before
+
+
+def test_reproducibility_corrections_cannot_enable_real_training():
+    from nas100lab.training_pipeline import training_acceptance_gates, prepare_real_data_training, TrainingDisabledError
+    evidence = {item['gate']: True for item in training_acceptance_gates()['gates']}
+    evidence['explicit_owner_approval_id'] = 'APPROVED'
+    assert training_acceptance_gates(**evidence)['training_enabled'] is False
+    with pytest.raises(TrainingDisabledError):
+        prepare_real_data_training(**evidence)
