--- /dev/null
+++ b/tests/test_codex_m2_timebase_observation.py
@@ -0,0 +1,40 @@
+"""Synthetic clock observations, without broker I/O or dataset certification."""
+from datetime import datetime, timedelta, timezone
+import pytest
+from nas100lab.timebase_observation import assess_tick_clock
+
+
+def observation(shift=0, **changes):
+    before = datetime(2026, 3, 29, 0, 59, 59, tzinfo=timezone.utc)
+    args = dict(raw_epoch=int(before.timestamp())+shift, utc_before=before,
+                utc_after=before+timedelta(seconds=2), monotonic_elapsed_seconds=2)
+    return assess_tick_clock(**(args | changes))
+
+
+@pytest.mark.parametrize('shift', [7200, 10800])
+def test_future_broker_clock_is_contradictory_not_corrected(shift):
+    result = observation(shift)
+    assert result['observation'] == 'SOURCE_LABEL_AHEAD_OF_UTC_BRACKET'
+    assert result['raw_epoch_preserved'] is True
+    assert result['timebase_status'] == 'TIMEBASE_UNVERIFIED'
+    assert result['research_eligible'] is False
+
+
+def test_consistent_observation_does_not_certify_history():
+    result = observation()
+    assert result['observation'] == 'WITHIN_UTC_BRACKET_NOT_CERTIFIED'
+    assert result['research_eligible'] is False
+
+
+def test_stale_quote_is_not_treated_as_timezone_evidence():
+    assert observation(-3600)['observation'] == 'STALE_OR_DIFFERENT_CLOCK_UNRESOLVED'
+
+
+def test_clock_step_invalidates_observation():
+    with pytest.raises(ValueError, match='clock'):
+        observation(monotonic_elapsed_seconds=0.2)
+
+
+def test_naive_wall_clock_rejected():
+    with pytest.raises(ValueError, match='UTC'):
+        observation(utc_before=datetime(2026, 3, 29))
