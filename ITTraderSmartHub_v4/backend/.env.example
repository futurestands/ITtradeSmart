# Windows host only; never commit real values or transfer them to Android.
MT5_LOGIN=12345678
MT5_INVESTOR_PASSWORD=replace-on-windows
MT5_SERVER=your-broker-server
# Generate 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SMARTHUB_API_TOKEN=replace-with-random-secret-at-least-32-characters
# V4: separate key for trusted local telemetry collector. Never place in Android.
SMARTHUB_TELEMETRY_TOKEN=replace_with_an_independent_random_value_of_32_or_more_characters
# Local advisory-only Lab companion; NEVER use the master API/device/telemetry token.
SMARTHUB_AI_LAB_URL=http://127.0.0.1:8765
SMARTHUB_AI_LAB_TOKEN=

# Optional: absolute Windows Lab project root for read-only local SYNTHETIC report dashboard.
# The Gateway reads only reports/synthetic_confluence_stress.json; no real CSVs or models.
# Never expose this path, contents, or Lab tokens to the Android device.
SMARTHUB_NAS100_LAB_ROOT=

# Optional read-only MULTI-account alias registry; supports 0–20 records.
# Without this variable, the Gateway auto-discovers an ignored local file:
#   backend/mt5_accounts.local.json (copy from mt5_accounts.example.json)
# The file lists display aliases only, NEVER broker logins, investor passwords,
# MT5 installation paths, account balances, MT5 orders or account secrets.
# Registration is NOT proof of an active MT5 connection or EA authorization.
SMARTHUB_MT5_ACCOUNTS_FILE=
