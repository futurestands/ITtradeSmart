<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="16dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_card">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/research_profile_heading" android:textColor="@color/accent_blue" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/research_profile_note" android:textColor="@color/text_secondary" android:layout_marginTop="8dp" />
    <Spinner android:id="@+id/spnResearchProfile" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/research_profile_select" />
    <Spinner android:id="@+id/spnResearchFirm" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/research_profile_firm" />
    <EditText android:id="@+id/edtResearchLabel" android:layout_width="match_parent" android:layout_height="48dp" android:hint="@string/research_profile_label" android:inputType="textCapWords" android:maxLength="80" android:importantForAutofill="no" android:singleLine="true" android:textColor="@color/text_primary" />
    <EditText android:id="@+id/edtResearchProgramme" android:layout_width="match_parent" android:layout_height="48dp" android:hint="@string/research_profile_programme" android:inputType="textCapWords" android:maxLength="80" android:importantForAutofill="no" android:singleLine="true" android:textColor="@color/text_primary" />
    <EditText android:id="@+id/edtResearchStage" android:layout_width="match_parent" android:layout_height="48dp" android:hint="@string/research_profile_stage" android:inputType="textCapWords" android:maxLength="80" android:importantForAutofill="no" android:singleLine="true" android:textColor="@color/text_primary" />
    <EditText android:id="@+id/edtResearchCurrency" android:layout_width="match_parent" android:layout_height="48dp" android:hint="@string/research_profile_currency" android:inputType="textCapCharacters" android:maxLength="3" android:importantForAutofill="no" android:singleLine="true" android:textColor="@color/text_primary" />
    <EditText android:id="@+id/edtResearchSize" android:layout_width="match_parent" android:layout_height="48dp" android:hint="@string/research_profile_size" android:inputType="numberDecimal" android:maxLength="15" android:importantForAutofill="no" android:singleLine="true" android:textColor="@color/text_primary" />
    <EditText android:id="@+id/edtResearchTerms" android:layout_width="match_parent" android:layout_height="48dp" android:hint="@string/research_profile_terms" android:inputType="textNoSuggestions" android:maxLength="80" android:importantForAutofill="no" android:singleLine="true" android:textColor="@color/text_primary" />
    <Button android:id="@+id/btnSaveResearchProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/research_profile_save" android:textColor="@color/black" app:backgroundTint="@color/accent_blue" />
    <Button android:id="@+id/btnOpenResearchRules" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/research_profile_rules" android:textColor="@color/text_primary" app:backgroundTint="@color/card_stroke" />
    <TextView android:id="@+id/txtResearchProfileStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/research_profile_unverified" android:textColor="@color/text_secondary" android:accessibilityLiveRegion="polite" />
</LinearLayout>
