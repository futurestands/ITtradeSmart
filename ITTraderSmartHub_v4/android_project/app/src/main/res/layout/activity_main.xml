<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Dashboard Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/txtHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ITTRADER SMARTHUB"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automated Trading &amp; Risk Intelligence v5"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● ACTIVE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/status_green"
                android:background="@drawable/bg_pill_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- Live Ticker Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REAL-TIME MARKET FEED"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BINANCE BTC/USDT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_blue"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <TextView
                android:id="@+id/txtLivePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Live BTC/USDT: Connecting..."
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingTop="6dp" />
        </LinearLayout>

        <!-- Section 1: Device Pairing Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. SECURE DEVICE PAIRING &amp; GATEWAY"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:letterSpacing="0.05"
                android:paddingBottom="10dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintTextColor="@color/text_secondary"
                app:boxStrokeColor="@color/card_stroke"
                android:textColorHint="@color/text_muted"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/edtGatewayIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="HTTPS Gateway URL"
                    android:inputType="textUri"
                    android:text="https://127.0.0.1:5000"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintTextColor="@color/text_secondary"
                app:boxStrokeColor="@color/card_stroke"
                android:textColorHint="@color/text_muted"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/edtPairingCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="One-Time Pairing Code (e.g. PAIR-123456)"
                    android:inputType="textCapCharacters"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEnrollDevice"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Pair Device"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_blue"
                    android:textColor="@color/black"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Revoke Session"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/status_red"
                    android:textColor="@color/white"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 2: V5 AUTOMATED TRADING BOT CONTROL CENTRE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. V5 TRADING BOT CONTROL CENTRE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:letterSpacing="0.05"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnBotOff"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="BOT OFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/card_stroke"
                    android:textColor="@color/text_primary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnBotBacktest"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="BACKTEST LAB"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_blue"
                    android:textColor="@color/black"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBotPaper"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="PAPER TRADING"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/status_green"
                    android:textColor="@color/black"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnBotEmergencyStop"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="EMERGENCY STOP"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/status_red"
                    android:textColor="@color/white"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 3: PIPNEX Smart Lot Size & Pip Calculator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. PIPNEX SMART LOT &amp; PIP CALCULATOR"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:letterSpacing="0.05"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:hintTextColor="@color/text_secondary">

                    <EditText
                        android:id="@+id/edtAccountBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Balance ($)"
                        android:inputType="numberDecimal"
                        android:text="10000"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:hintTextColor="@color/text_secondary">

                    <EditText
                        android:id="@+id/edtRiskPercentage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Base Risk %"
                        android:inputType="numberDecimal"
                        android:text="1.0"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:hintTextColor="@color/text_secondary">

                    <EditText
                        android:id="@+id/edtStopLossPips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Stop Loss (Pips)"
                        android:inputType="numberDecimal"
                        android:text="20"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:hintTextColor="@color/text_secondary">

                    <EditText
                        android:id="@+id/edtSymbol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Symbol"
                        android:text="BTCUSD"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:hintTextColor="@color/text_secondary">

                <EditText
                    android:id="@+id/edtStopLossPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Stop Loss Price ($) [For Log Audit]"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPipnexCalc"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Calculate MT5 Lots"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_blue"
                    android:textColor="@color/black"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQueryRiskContext"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="V4 Risk Fusion"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/card_stroke"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 4: PIPNEX Prop Firm Drawdown Shield -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. PIPNEX PROP FIRM DRAWDOWN SHIELD"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:letterSpacing="0.05"
                android:paddingBottom="10dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintTextColor="@color/text_secondary"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/edtDailyStartEquity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Daily Start Equity ($)"
                    android:inputType="numberDecimal"
                    android:text="10000"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPipnexPropFirm"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Check Drawdown Shield"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/status_amber"
                    android:textColor="@color/black"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnSyncMt5"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Sync MT5 History"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/card_stroke"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 5: IT Infrastructure Log Audit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. IT INFRASTRUCTURE LOG AUDIT"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:letterSpacing="0.05"
                android:paddingBottom="10dp" />

            <EditText
                android:id="@+id/edtLogs"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="Paste server logs or infrastructure traces..."
                android:gravity="top"
                android:textSize="12sp"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:padding="10dp"
                android:inputType="textMultiLine"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnProcess"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Audit System Logs &amp; Compute Stress Index"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/card_stroke"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Section 6: Alert Center & Incident Research Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. ALERT CENTER &amp; INCIDENT RESEARCH"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:letterSpacing="0.05"
                android:paddingBottom="10dp" />

            <!-- Disabled Legacy MT5 Inputs (Preserved for compatibility) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0"
                android:visibility="gone"
                android:orientation="vertical">
                <EditText android:id="@+id/edtMt5Login" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <EditText android:id="@+id/edtMt5Password" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <EditText android:id="@+id/edtMt5Server" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnQueryAlerts"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Fetch Alerts"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/card_stroke"
                    android:textColor="@color/text_primary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQueryResearch"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Incident Impact"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/card_stroke"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 7: Real-Time Telemetry & Terminal Monitor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_terminal"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TELEMETRY &amp; ANALYSIS CONSOLE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_blue"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMARTHUB v5.1"
                    android:textSize="10sp"
                    android:textColor="@color/text_muted"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <TextView
                android:id="@+id/txtAnalysisOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="System Ready. Listening for market events &amp; bot telemetry..."
                android:textSize="12sp"
                android:typeface="monospace"
                android:textColor="#38BDF8"
                android:minLines="7"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
